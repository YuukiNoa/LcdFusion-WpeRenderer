+
+inline u32 GlslTypeLocationSlots(const std::string& type, u32 arrCount) {
+    u32 base = 1;
+    if (type.find("mat4") != std::string::npos || type.find("dmat4") != std::string::npos)
+        base = 4;
+    else if (type.find("mat3") != std::string::npos || type.find("dmat3") != std::string::npos)
+        base = 3;
+    else if (type.find("mat2") != std::string::npos || type.find("dmat2") != std::string::npos)
+        base = 2;
+    return base * std::max<u32>(1, arrCount);
+}
+
+inline std::vector<TopLevelIoDecl> FindTopLevelStageIo(const std::string& src,
+                                                       std::string_view   storageQual) {
+    std::vector<TopLevelIoDecl> result;
+    const std::regex re_decl(
+        R"(^((?:flat|smooth|noperspective|centroid|sample|invariant|precise|highp|mediump|lowp)\s+)*(in|out)\s+((?:highp|mediump|lowp)\s+)?([A-Za-z_]\w*)\s+([A-Za-z_]\w*)(?:\s*\[\s*(\d+)\s*\])?\s*$)",
+        std::regex::ECMAScript);
+
+    int   braceDepth = 0;
+    usize stmtStart  = 0;
+    usize n          = src.size();
+
+    for (usize i = 0; i < n; i++) {
+        char c = src[i];
+        // Skip preprocessor lines
+        if (c == '#' && (i == 0 || src[i - 1] == '\n')) {
+            while (i < n && src[i] != '\n') i++;
+            if (braceDepth == 0) stmtStart = i + 1;
+            continue;
+        }
+        // Skip line comments
+        if (c == '/' && i + 1 < n && src[i + 1] == '/') {
+            while (i < n && src[i] != '\n') i++;
+            continue;
+        }
+        // Skip block comments
+        if (c == '/' && i + 1 < n && src[i + 1] == '*') {
+            i += 2;
+            while (i + 1 < n && ! (src[i] == '*' && src[i + 1] == '/')) i++;
+            i++;
+            continue;
+        }
+        if (c == '{') {
+            braceDepth++;
+        } else if (c == '}') {
+            if (braceDepth > 0) braceDepth--;
+            if (braceDepth == 0) stmtStart = i + 1;
+        } else if (c == ';' && braceDepth == 0) {
+            usize s = stmtStart;
+            while (s < i && std::isspace(static_cast<unsigned char>(src[s]))) s++;
+            usize e = i;
+            while (e > s && std::isspace(static_cast<unsigned char>(src[e - 1]))) e--;
+            if (e > s) {
+                std::string stmt = src.substr(s, e - s);
+                if (stmt.find("layout") == std::string::npos &&
+                    stmt.find('(') == std::string::npos &&
+                    stmt.find(',') == std::string::npos) {
+                    std::smatch m;
+                    if (std::regex_match(stmt, m, re_decl) && m[2].str() == storageQual) {
+                        std::string varName = m[5].str();
+                        if (! sstart_with(varName, "gl_")) {
+                            u32 arrCount = 1;
+                            if (m[6].matched) {
+                                u32 parsed = 1;
+                                auto arrStr = m[6].str();
+                                std::from_chars(arrStr.data(), arrStr.data() + arrStr.size(), parsed);
+                                arrCount = std::max<u32>(1, parsed);
+                            }
+                            result.push_back(TopLevelIoDecl {
+                                .start = s,
+                                .name  = varName,
+                                .slots = GlslTypeLocationSlots(m[4].str(), arrCount),
+                            });
+                        }
+                    }
+                }
+            }
+            stmtStart = i + 1;
+        }
+    }
+    return result;
+}
+
+inline void AssignInterStageLocations(std::string& prevSrc, std::string& nextSrc) {
+    auto outs = FindTopLevelStageIo(prevSrc, "out");
+    auto ins  = FindTopLevelStageIo(nextSrc, "in");
+    if (outs.empty() && ins.empty()) return;
+
+    std::map<std::string, u32> slotCounts;
+    for (const auto& d : outs) {
+        slotCounts[d.name] = std::max(slotCounts[d.name], d.slots);
+    }
+    for (const auto& d : ins) {
+        slotCounts[d.name] = std::max(slotCounts[d.name], d.slots);
+    }
+
+    std::map<std::string, u32> locMap;
+    u32                        nextLoc = 0;
+    for (const auto& [name, slots] : slotCounts) {
+        locMap[name] = nextLoc;
+        nextLoc += slots;
+    }
+
+    auto applyLocs = [&locMap](std::string& src, const std::vector<TopLevelIoDecl>& decls) {
+        // Insert in reverse offset order so earlier offsets stay valid.
+        for (auto it = decls.rbegin(); it != decls.rend(); ++it) {
+            auto locIt = locMap.find(it->name);
+            if (locIt == locMap.end()) continue;
+            src.insert(it->start, "layout(location = " + std::to_string(locIt->second) + ") ");
+        }
+    };
+    applyLocs(prevSrc, outs);
+    applyLocs(nextSrc, ins);
+}
